# =============================================================================
# MCP server environment — copy to `.env`, fill in, then `chmod 600 .env`.
# docker compose loads this automatically when run from this directory.
# NEVER commit the real .env (it holds secrets). Commit only this .example.
# =============================================================================

# ---- Public URL (REQUIRED) --------------------------------------------------
# FastMCP's GitHubProvider derives the OAuth callback from this. No trailing
# slash; must match the GitHub OAuth app's callback exactly.
PUBLIC_BASE_URL=https://mcp.example-client.com

# ---- BigQuery (REQUIRED) ----------------------------------------------------
GCP_PROJECT=example-client-mds-prod
BQ_LOCATION=EU
# Path INSIDE the container to the read-only SA key (matches the volume mount).
GOOGLE_APPLICATION_CREDENTIALS=/secrets/bq-mcp-reader.json
GCP_CREDS_PATH=/secrets/bq-mcp-reader.json

# ---- Read caps (OPTIONAL — sensible defaults baked into server.py) ----------
MAX_BYTES_BILLED=2147483648   # 2 GiB
MAX_ROWS=1000

# ---- Inbound auth (REQUIRED) ------------------------------------------------
# GitHub OAuth app credentials.
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated GitHub logins allowed to connect. Empty = any authenticated
# GitHub user (NOT recommended once write tools are on).
ALLOWED_GITHUB_USERS=acme-cto,acme-data-analyst

# ---- Write tools (OFF BY DEFAULT — leave off unless you need them) ----------
# The server exposes externally-ingested (untrusted) data to an AI agent, so a
# write tool is a prompt-injection surface. Writes are therefore OFF by default,
# and when ON they OPEN A PULL REQUEST for human review — they NEVER push to main.
#
# To ENABLE writes, set BOTH of the following:
#   1) MCP_WRITE_TOOLS=on
#   2) GITHUB_TOKEN = a fine-grained PAT scoped to THIS repo only, with scopes
#      contents:write  (push the claude-bot/edit-<ts> branch)
#      pull_requests:write  (open the PR against main)
# The server refuses to start with MCP_WRITE_TOOLS=on but no GITHUB_TOKEN.
# Rotate the PAT ~every 90 days: edit GITHUB_TOKEN + restart the container.
#
# Leave this off (the default) for a read-only server — no PAT needed at all.
MCP_WRITE_TOOLS=off
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx   # uncomment only when MCP_WRITE_TOOLS=on
# MCP_PR_BASE=main                                   # base branch for the PR (default: main)
