-- =============================================================================
-- STAGING MODEL TEMPLATE  —  stg_<SOURCE>_<TABLE>.sql
-- =============================================================================
-- Copy this file to:
--   models/staging/<SOURCE>/stg_<SOURCE>_<TABLE>.sql
--
-- A staging model is a 1:1 cleanup of ONE raw source table: rename columns to
-- snake_case, cast types explicitly, drop garbage rows. No joins, no business
-- logic (that belongs in intermediate/marts). Materialized as a VIEW — cheap to
-- rebuild because it stores no data.
--
-- Replace every <PLACEHOLDER>:
--   <SOURCE>  the source name as declared in _<SOURCE>__sources.yml (e.g. factorial)
--   <TABLE>   the raw table name inside that source            (e.g. employees)
--   <ENTITY>  the singular entity this table represents        (e.g. employee)
--   <PK>      the raw primary-key column                       (e.g. id)
--
-- Conventions enforced (see references/dbt-naming-conventions.md):
--   - lowercase keywords, snake_case columns, trailing commas, one col per line
--   - primary key renamed to <entity>_id (never bare `id`)
--   - explicit casts even when the type looks right (guards against schema drift)
--   - the ingest load id (`load_id`) is carried through for downstream freshness
--   - `select * from renamed` is the ONLY `*` allowed (selecting a CTE, not raw)
--
-- Load metadata is ingestion-tool agnostic. Pick the column your loader writes
-- onto every raw row:
--   - dlt (current default):  _dlt_load_id  — an opaque LOAD-ID STRING, not a
--                             timestamp. Carry it as `load_id`; the wall-clock
--                             time lives in the `_dlt_loads` table (join on
--                             load_id when you need an actual `loaded_at`).
--   - Airbyte (legacy):       _airbyte_extracted_at — already a timestamp, so
--                             alias it straight to `loaded_at`.
-- Downstream freshness checks and incremental watermarks (see
-- references/incremental-and-cost.md) key off this metadata regardless of tool.
-- =============================================================================

{{ config(materialized='view') }}

with source as (

    select * from {{ source('<SOURCE>', '<TABLE>') }}

),

renamed as (

    select
        -- Identifiers
        <PK>                            as <ENTITY>_id,
        -- company_id                   as company_id,

        -- Attributes (cast explicitly — protects against raw schema drift)
        -- raw_string_col               as <some_name>,
        -- cast(raw_number_col as int)  as <some_count>,
        -- cast(raw_amount_col as numeric) as <some>_amount,
        -- cast(raw_date_col as date)   as <event>_date,
        -- cast(raw_ts_col as timestamp) as <event>_at,
        -- cast(raw_bool_col as bool)   as is_<predicate>,

        -- Metadata (used by downstream freshness checks + incremental watermarks)
        -- dlt's _dlt_load_id is an opaque load-id STRING, not a timestamp —
        -- carry it as load_id; join _dlt_loads for the wall-clock time.
        -- (Airbyte legacy: _airbyte_extracted_at is a timestamp → `as loaded_at`.)
        _dlt_load_id                    as load_id

    from source
    where <PK> is not null     -- drop garbage rows that lack a primary key

)

select * from renamed
